# 복사해서 terraform.tfvars로 쓴다: cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars는 .gitignore 대상 — 실제 값은 절대 커밋하지 않는다.
api_key           = "<API Key>"
secret_key        = "<Secret Key>"
student_id        = "<학번>"
shared_network_id = "<Shared Network UUID>"
ssh_public_key    = "<cat ~/.ssh/id_ed25519.pub 결과>"
